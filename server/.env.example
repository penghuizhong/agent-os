# Cloudflare Workers 环境变量配置
# 敏感变量通过 `wrangler secret put` 设置，非敏感变量在 wrangler.toml [vars] 中配置

# === 敏感变量 (wrangler secret put) ===
# JWT 签名密钥
# wrangler secret put JWT_SECRET
# 输入一个随机字符串，如: openssl rand -hex 32

# Qwen API Key
# wrangler secret put QWEN_API_KEY
# 从 https://maas.qianwenaiapi.com 获取

# === 非敏感变量 (wrangler.toml [vars]) ===
# QWEN_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
# QWEN_MODEL=qwen3.8-flash
# CORS_ORIGINS=*
